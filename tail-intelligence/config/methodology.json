    "watchlistMarkets": ["dram"],
    "signalDriverImpact": {
      "demand_up": { "demand": 1, "aiDemand": 1 },
      "price_up": { "pricing": 1 },
      "price_down": { "pricing": -1 },
      "negative_supply": { "availability": 1 },
      "capacity_lock": { "availability": 0.95, "aiDemand": 0.6 },
      "capacity_relief": {},
      "geopolitical_split": { "availability": 0.5 }
